
@article{avlonitis2005,
	series = {Technology and the {Sales} {Force}},
	title = {Antecedents and consequences of {CRM} technology acceptance in the sales force},
	volume = {34},
	issn = {0019-8501},
	url = {https://www.sciencedirect.com/science/article/pii/S001985010400149X},
	doi = {10.1016/j.indmarman.2004.09.021},
	abstract = {Two conceptual approaches [Davis, F. D. (1989). Perceived usefulness, perceived ease of use, and user acceptance of information technology. MIS Quarterly, 13 (3), 319–340; DeLone, W. H., \& McLean, E. R. (1992). Information systems success: The quest for the dependent variable. Information Systems Research, 3 (1), 60–95] are unified into a conceptual model that offers a comprehensive explanation of CRM acceptance antecedents and consequences in a sales force setting. Based upon responses from 240 salespersons that utilize a CRM system, the model is tested and explanations are offered for the system's acceptance. Specifically, the most prevailing influence on CRM acceptance comes from CRM perceived usefulness, followed by the setting of accurate expectations regarding system usage, the salesperson innovativeness towards new technological tools, the CRM perceived ease-of-use, and the supervisor encouragement and support. Surprisingly, the model does not adequately explicate salesperson performance. Sales managers are presented with a discussion and implications of the findings.},
	number = {4},
	urldate = {2026-09-17},
	journal = {Industrial Marketing Management},
	author = {Avlonitis, George J. and Panagopoulos, Nikolaos G.},
	month = may,
	year = {2005},
	keywords = {CRM, Information technology acceptance, Salesperson performance, Tim Arana},
	pages = {355--368},
	file = {ScienceDirect Snapshot:/Users/timarana/Zotero/storage/LC77FAX5/S001985010400149X.html:text/html},
}

@article{guan2004,
	title = {Sales {Force} {Automation} {Acceptance}: {An} {Exploratory} {Study} {Of} {The} {Role} {Of} {Job} {Experience}},
	volume = {20},
	issn = {2157-8834},
	shorttitle = {Sales {Force} {Automation} {Acceptance}},
	url = {https://clutejournals.com/},
	doi = {10.19030/jabr.v20i3.2219},
	abstract = {User perceptions of new technologies may ultimately affect their acceptance of that technology. Recent research has identified a clear connection between user perceptions of Sales Force Automation and their acceptance of Sales Force Automation technologies.  Anecdotal evidence suggests that relative to less experienced salespeople, more experienced salespeople tend to have more negative perceptions of sales force automation.  This paper examines the relationship between job experience and perceptions of a sales force automation system.  The results are based on a survey of 1,657 salespeople about their perceptions of several aspects of a sales force automation system in a large sales organization.  This study finds significant differences by sales experience in areas such as perceived productivity/efficiency gain, perception of sales force automation as a micromanagement tool, and user satisfaction with system functionality.  Based on these results several important managerial implications for the adoption of a sales force automation system are suggested.},
	language = {en},
	number = {3},
	urldate = {2026-09-24},
	journal = {Journal of Applied Business Research (JABR)},
	author = {Guan, Jian and Barker, Robert M. and Faulds, David J. and Gohmann, Stephan F.},
	month = jul,
	year = {2004},
}

