@article{avlonitis2005,
  series = {Technology and the {Sales} {Force}},
  title = {Antecedents and Consequences of {CRM} Technology Acceptance in the Sales Force},
  volume = {34},
  issn = {0019-8501},
  url = {https://www.sciencedirect.com/science/article/pii/S001985010400149X},
  doi = {10.1016/j.indmarman.2004.09.021},
  abstract = {Two conceptual approaches are unified into a conceptual model that offers a comprehensive explanation of CRM acceptance antecedents and consequences in a sales force setting. Based upon responses from 240 salespersons that utilize a CRM system, the model is tested and explanations are offered for the system's acceptance. Specifically, the most prevailing influence on CRM acceptance comes from CRM perceived usefulness, followed by the setting of accurate expectations regarding system usage, salesperson innovativeness towards new technological tools, CRM perceived ease-of-use, and supervisor encouragement and support.},
  number = {4},
  urldate = {2026-09-17},
  journal = {Industrial Marketing Management},
  author = {Avlonitis, George J. and Panagopoulos, Nikolaos G.},
  month = may,
  year = {2005},
  keywords = {CRM, Information technology acceptance, Salesperson performance},
  pages = {355--368}
}

@article{guan2004,
  title = {Sales {Force} {Automation} {Acceptance}: {An} {Exploratory} {Study} {Of} {The} {Role} {Of} {Job} {Experience}},
  volume = {20},
  issn = {2157-8834},
  shorttitle = {Sales {Force} {Automation} {Acceptance}},
  url = {https://clutejournals.com/},
  doi = {10.19030/jabr.v20i3.2219},
  abstract = {User perceptions of new technologies may ultimately affect their acceptance of that technology. Recent research has identified a clear connection between user perceptions of Sales Force Automation and their acceptance of Sales Force Automation technologies. Anecdotal evidence suggests that relative to less experienced salespeople, more experienced salespeople tend to have more negative perceptions of sales force automation. This paper examines the relationship between job experience and perceptions of a sales force automation system. The results are based on a survey of 1,657 salespeople about their perceptions of several aspects of a sales force automation system in a large sales organization. This study finds significant differences by sales experience in areas such as perceived productivity/efficiency gain, perception of sales force automation as a micromanagement tool, and user satisfaction with system functionality.},
  language = {en},
  number = {3},
  urldate = {2026-09-24},
  journal = {Journal of Applied Business Research (JABR)},
  author = {Guan, Jian and Barker, Robert M. and Faulds, David J. and Gohmann, Stephan F.},
  month = jul,
  year = {2004}
}

